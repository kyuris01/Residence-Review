# ─────────────────────────────────────────────────────────────
# 배치 스크립트 전용 키 목록 — 이 파일은 '템플릿'이라 git 에 커밋된다.
# 실제 키는 여기에 적지 말고 .env 에 넣는다 (.gitignore 로 제외됨).
#   cp .env.example .env
# 프론트(web)는 키가 하나도 필요 없다. 지도는 OpenStreetMap 을 쓴다.
# ─────────────────────────────────────────────────────────────

# ① base.py — 공공데이터포털(data.go.kr) 인증키
#    Encoding / Decoding 어느 값을 넣어도 config.py 가 알아서 디코딩해 쓴다.
KAPT_SERVICE_KEY=

# ① base.py — 단지 좌표 조회 (선택이지만 넣는 것을 강력히 권장)
#    VWorld(국토교통부 공간정보 오픈플랫폼) 지오코더. 무료이고 한국 주소 정확도가 가장 좋다.
#    비워두면 OSM Nominatim 으로 조회하며, 못 찾은 단지는 콘솔과 coords.missing.json 에 나온다.
VWORLD_API_KEY=

# ① base.py — Nominatim 이용 정책상 권장되는 연락처 (선택)
NOMINATIM_EMAIL=

# ② collect.py — Tavily 검색 API. https://app.tavily.com 에서 발급 (무료 월 1,000 크레딧)
TAVILY_API_KEY=

# ② collect.py — 유튜브 Data API v3 (P1, 없어도 동작)
YOUTUBE_API_KEY=

# ③ summarize.py — Claude API
ANTHROPIC_API_KEY=

# (선택) 빛가람동 법정동코드 10자리를 알면 넣는다. 비워두면 나주시 전체를 받아
#        주소에 '빛가람동'이 들어가는 단지만 걸러 쓴다.
BJD_CODE=

# (선택) 정성 요약을 만들 최소 근거 건수. 기본 3
MIN_EVIDENCE=3
